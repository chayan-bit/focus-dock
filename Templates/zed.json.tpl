{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "FocusDock",
  "author": "FocusDock (palette mapping from Omarchy's vscode-theme.json.tpl)",
  "themes": [
    {
      "name": "FocusDock",
      "appearance": "{{ mode }}",
      "style": {
        "background": "{{ background }}",
        "border": "{{ muted }}40",
        "border.variant": "{{ muted }}30",
        "border.focused": "{{ accent }}80",
        "border.selected": "{{ accent }}80",
        "border.transparent": "#00000000",
        "border.disabled": "{{ muted }}30",
        "elevated_surface.background": "{{ background }}",
        "surface.background": "{{ background }}",
        "element.background": "{{ background }}",
        "element.hover": "{{ mix background foreground 6% }}",
        "element.active": "{{ accent }}30",
        "element.selected": "{{ accent }}30",
        "element.disabled": "{{ background }}",
        "drop_target.background": "{{ accent }}20",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ mix background foreground 6% }}",
        "ghost_element.active": "{{ accent }}30",
        "ghost_element.selected": "{{ accent }}30",
        "ghost_element.disabled": "#00000000",
        "text": "{{ foreground }}",
        "text.muted": "{{ muted }}",
        "text.placeholder": "{{ muted }}",
        "text.disabled": "{{ dark_foreground }}",
        "text.accent": "{{ accent }}",
        "icon": "{{ foreground }}",
        "icon.muted": "{{ muted }}",
        "icon.disabled": "{{ dark_foreground }}",
        "icon.placeholder": "{{ muted }}",
        "icon.accent": "{{ accent }}",
        "status_bar.background": "{{ background }}",
        "title_bar.background": "{{ background }}",
        "title_bar.inactive_background": "{{ background }}",
        "toolbar.background": "{{ background }}",
        "tab_bar.background": "{{ background }}",
        "tab.inactive_background": "{{ background }}",
        "tab.active_background": "{{ mix background foreground 6% }}",
        "search.match_background": "{{ yellow }}40",
        "panel.background": "{{ background }}",
        "panel.focused_border": "{{ accent }}80",
        "pane.focused_border": "{{ accent }}80",
        "pane_group.border": "{{ muted }}40",
        "scrollbar.thumb.background": "{{ muted }}40",
        "scrollbar.thumb.hover_background": "{{ muted }}80",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "editor.foreground": "{{ foreground }}",
        "editor.background": "{{ background }}",
        "editor.gutter.background": "{{ background }}",
        "editor.subheader.background": "{{ background }}",
        "editor.active_line.background": "{{ mix background foreground 6% }}",
        "editor.highlighted_line.background": "{{ mix background foreground 6% }}",
        "editor.line_number": "{{ muted }}",
        "editor.active_line_number": "{{ foreground }}",
        "editor.invisible": "{{ muted }}60",
        "editor.wrap_guide": "{{ muted }}30",
        "editor.active_wrap_guide": "{{ muted }}60",
        "editor.indent_guide": "{{ muted }}30",
        "editor.indent_guide_active": "{{ muted }}80",
        "editor.document_highlight.read_background": "{{ accent }}20",
        "editor.document_highlight.write_background": "{{ accent }}30",
        "terminal.background": "{{ background }}",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ bright_foreground }}",
        "terminal.dim_foreground": "{{ dark_foreground }}",
        "terminal.ansi.black": "{{ background }}",
        "terminal.ansi.red": "{{ red }}",
        "terminal.ansi.green": "{{ green }}",
        "terminal.ansi.yellow": "{{ yellow }}",
        "terminal.ansi.blue": "{{ blue }}",
        "terminal.ansi.magenta": "{{ magenta }}",
        "terminal.ansi.cyan": "{{ cyan }}",
        "terminal.ansi.white": "{{ foreground }}",
        "terminal.ansi.bright_black": "{{ muted }}",
        "terminal.ansi.bright_red": "{{ bright_red }}",
        "terminal.ansi.bright_green": "{{ bright_green }}",
        "terminal.ansi.bright_yellow": "{{ bright_yellow }}",
        "terminal.ansi.bright_blue": "{{ bright_blue }}",
        "terminal.ansi.bright_magenta": "{{ bright_magenta }}",
        "terminal.ansi.bright_cyan": "{{ bright_cyan }}",
        "terminal.ansi.bright_white": "{{ bright_foreground }}",
        "link_text.hover": "{{ blue }}",
        "conflict": "{{ orange }}",
        "created": "{{ green }}",
        "deleted": "{{ red }}",
        "modified": "{{ orange }}",
        "renamed": "{{ blue }}",
        "error": "{{ red }}",
        "error.background": "{{ mix background red 12% }}",
        "warning": "{{ yellow }}",
        "warning.background": "{{ mix background yellow 12% }}",
        "info": "{{ blue }}",
        "info.background": "{{ mix background blue 12% }}",
        "success": "{{ green }}",
        "hint": "{{ muted }}",
        "hidden": "{{ dark_foreground }}",
        "ignored": "{{ dark_foreground }}",
        "predictive": "{{ muted }}",
        "unreachable": "{{ dark_foreground }}",
        "players": [
          { "cursor": "{{ bright_foreground }}", "background": "{{ accent }}", "selection": "{{ selection_background }}60" }
        ],
        "syntax": {
          "comment": { "color": "{{ muted }}" },
          "comment.doc": { "color": "{{ muted }}" },
          "variable": { "color": "{{ foreground }}" },
          "variable.special": { "color": "{{ foreground }}", "font_style": "italic" },
          "variable.parameter": { "color": "{{ cyan }}", "font_style": "italic" },
          "property": { "color": "{{ cyan }}" },
          "constant": { "color": "{{ bright_yellow }}" },
          "enum": { "color": "{{ yellow }}" },
          "variant": { "color": "{{ orange }}" },
          "keyword": { "color": "{{ bright_magenta }}" },
          "operator": { "color": "{{ bright_blue }}" },
          "type": { "color": "{{ yellow }}" },
          "constructor": { "color": "{{ yellow }}" },
          "function": { "color": "{{ blue }}" },
          "attribute": { "color": "{{ cyan }}", "font_style": "italic" },
          "punctuation": { "color": "{{ dark_foreground }}" },
          "punctuation.bracket": { "color": "{{ dark_foreground }}" },
          "punctuation.delimiter": { "color": "{{ dark_foreground }}" },
          "punctuation.list_marker": { "color": "{{ cyan }}" },
          "punctuation.special": { "color": "{{ bright_blue }}" },
          "number": { "color": "{{ orange }}" },
          "boolean": { "color": "{{ orange }}" },
          "string": { "color": "{{ green }}" },
          "string.escape": { "color": "{{ bright_magenta }}" },
          "string.regex": { "color": "{{ bright_cyan }}" },
          "string.special": { "color": "{{ bright_cyan }}" },
          "string.special.symbol": { "color": "{{ cyan }}" },
          "tag": { "color": "{{ yellow }}" },
          "label": { "color": "{{ blue }}" },
          "embedded": { "color": "{{ bright_blue }}" },
          "preproc": { "color": "{{ bright_magenta }}" },
          "title": { "color": "{{ blue }}", "font_weight": 700 },
          "emphasis": { "color": "{{ foreground }}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{ foreground }}", "font_weight": 700 },
          "link_text": { "color": "{{ blue }}" },
          "link_uri": { "color": "{{ blue }}" },
          "text.literal": { "color": "{{ green }}" },
          "primary": { "color": "{{ foreground }}" },
          "hint": { "color": "{{ muted }}" },
          "predictive": { "color": "{{ muted }}", "font_style": "italic" }
        }
      }
    }
  ]
}
